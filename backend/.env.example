# ---------------------------------------------------------------- OpenAI
# Required. Used to mint short-lived realtime client secrets and to clean up
# transcribed answers into report language.
OPENAI_API_KEY=sk-your-key-here

# Optional - these are the defaults.
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=marin
OPENAI_MODEL=gpt-5.6-terra

# ------------------------------------------------- AWS Polly (basic engine)
# Only needed if you want the step-by-step voice wizard. The realtime engine
# does not use these.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
TTS_VOICE=Joanna
TTS_ENGINE=generative

# ---------------------------------------------------------------- Server
PORT=3000
